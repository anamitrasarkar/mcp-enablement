# Rename this file to .env and fill in your values.

# --- Salesforce side ---
# Your My Domain URL, e.g. https://trailsignup-xxx.my.salesforce.com
SF_MY_DOMAIN_URL=

# External Client App credentials (client_credentials flow)
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=

# The Agent (BotDefinition) Id — from Setup → Agents → open the agent → copy from URL,
# or run: sf data query --query "SELECT Id FROM BotDefinition WHERE DeveloperName='AccountSummaryAgent'"
SF_AGENT_ID=

# Optional: override the Einstein API base. Use api.gov.salesforce.com for Gov Cloud.
# SF_EINSTEIN_API_BASE=https://api.salesforce.com

# --- MCP server side ---
# Port the HTTP MCP server listens on locally (Cloudflare tunnel points at this)
PORT=3000

# Optional bearer token. If set, callers must send `Authorization: Bearer <token>`.
# Strongly recommended when exposing via Cloudflare tunnel. Minimum 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_BEARER_TOKEN=
